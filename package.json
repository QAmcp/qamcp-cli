{
  "name": "qamcp-cli",
  "version": "0.1.6",
  "description": "Test any MCP server: connection, tools, security, login, resources and prompts. Hard facts, no AI judging.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "testing",
    "test-automation",
    "cli",
    "github-action",
    "ci",
    "security",
    "oauth",
    "developer-tools",
    "ai-agents"
  ],
  "license": "MIT",
  "author": "Abhiram Reddy Kalluru",
  "homepage": "https://github.com/abhiramreddykalluru01-debug/qamcp-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhiramreddykalluru01-debug/qamcp-cli.git"
  },
  "bugs": {
    "url": "https://github.com/abhiramreddykalluru01-debug/qamcp-cli/issues"
  },
  "type": "module",
  "bin": {
    "qamcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-force-exit --test-concurrency=1 test/score.test.ts test/toolSafety.test.ts test/heuristics.test.ts test/oauth.test.ts test/oauthSetup.test.ts test/cliArgs.test.ts test/ci.test.ts test/workflows.test.ts test/connectErrors.test.ts test/resourcesPrompts.test.ts test/stdio.test.ts test/signIn.test.ts test/errorKinds.test.ts test/specExam.test.ts test/htmlReport.test.ts test/cli.test.ts test/buggyServer.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
